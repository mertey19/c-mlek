# --- Admin paneli (/admin) -------------------------------------------------
# Panel şifresi (en az 10 karakter)
ADMIN_PASSWORD=
# Oturum çerezini imzalamak için rastgele değer (en az 32 karakter)
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- İçerik kaydı: GitHub (canlıda gerekli) --------------------------------
# Fine-grained token: yalnızca bu repo, "Contents: Read and write" izni
GITHUB_TOKEN=
# owner/repo biçiminde, örn. mertey19/tarsus-comlekcilik
GITHUB_REPO=
# Vercel'in yayınladığı dal (varsayılan: main)
GITHUB_BRANCH=main

# --- Teklif talepleri: Upstash Redis (Vercel Marketplace) ------------------
# Vercel → Storage → Upstash bağlanınca otomatik eklenir
KV_REST_API_URL=
KV_REST_API_TOKEN=
